---
// Seitenkopf der Rechtstexte: Überzeile, Titel, Lead – zentriert wie die Abschnittsköpfe der Startseite
interface Props { title: string; lead?: string; eyebrow?: string }
const { title, lead, eyebrow = 'Rechtliches' } = Astro.props;
---
<div class="d-head legal-head reveal">
  <div class="d-head__top"><span class="d-eyebrow">{eyebrow}</span>
  <h1 class="d-title">{title}</h1></div>
  {lead && <p class="lead">{lead}</p>}
</div>
