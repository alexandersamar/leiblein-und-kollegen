---
// Auswahlfeld im Markenstil (statt Browser-<select>): Feld wie die Eingabefelder, Chevron wie im Menü,
// Liste wie das Untermenü (weiß, abgeschrägte Ecke, Schatten). Wert steht im versteckten Feld „name“.
// Bedienung per Maus und Tastatur (Pfeile, Pos1/Ende, Enter, Esc) – Logik in main.js ([data-sel]).
interface Props { id: string; name: string; label: string; options: string[]; value?: string; class?: string }
const { id, name, label, options, value = options[0], class: cls = '' } = Astro.props;
---
<div class={`field ${cls}`}>
  <label id={`${id}-lbl`} for={id}>{label}</label>
  <div class="sel" data-sel>
    <button id={id} class="sel__btn" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-list`} aria-labelledby={`${id}-lbl ${id}`}>
      <span class="sel__val">{value}</span><svg class="icon sel__chev" aria-hidden="true"><use href="#i-chev"/></svg>
    </button>
    <ul id={`${id}-list`} class="sel__list" role="listbox" tabindex="-1" aria-labelledby={`${id}-lbl`} hidden>
      {options.map((o, i) => <li id={`${id}-o${i}`} role="option" aria-selected={o === value ? 'true' : 'false'} data-value={o}>{o}</li>)}
    </ul>
    <input type="hidden" name={name} value={value}>
  </div>
</div>
