---
// Abschluss-CTA (rote Fläche + Foto) – Startseite und Ende jeder Unterseite. Ohne Props = Text der Startseite.
import { firm, url } from '../../data/site';
interface Props {
  eyebrow?: string; title?: string; text?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string; icon?: string } | false;
  img?: { webp: string; src: string; alt: string; width: number; height: number };
}
const {
  eyebrow = 'Erstgespräch',
  title = 'Passt Ihr Unternehmen <em>zu uns?</em>',
  text = 'Finden Sie es in zwei Minuten heraus. Danach meldet sich unser Büro persönlich bei Ihnen – unverbindlich und deutschlandweit digital.',
  primary = { label: 'Jetzt Erstgespräch anfragen', href: url.anfrage },
  secondary = { label: firm.phone, href: firm.phoneHref, icon: 'i-phone' },
  img = { webp: '/assets/img/erstgespraech-800.webp 800w, /assets/img/erstgespraech-1200.webp 1200w', src: '/assets/img/erstgespraech-1200.jpg', alt: 'Steuerberaterin telefoniert am Schreibtisch mit einer Mandantin', width: 1200, height: 800 },
} = Astro.props;
---
<!-- ====================== 13 · Abschluss-CTA ====================== -->
<section class="section" id="anfrage">
  <div class="container">
    <div class="final-d reveal">
      <div>
        <div class="col-head"><div class="d-head__top"><span class="d-eyebrow">{eyebrow}</span>
        <h2 class="d-title" set:html={title} /></div>
        <p>{text}</p></div><div class="final-d__cta"><div class="btn-row">
          <a class="btn btn--dark" href={primary.href}>{primary.label} <svg class="icon icon--arrow"><use href="#i-arrow"/></svg></a>
          {secondary && <a class="btn btn--line" href={secondary.href}>{secondary.icon && <svg class="icon"><use href={`#${secondary.icon}`}/></svg>} {secondary.label}</a>}
        </div></div>
      </div>
      <div class="final-d__ph"><picture><source type="image/webp" srcset={img.webp} sizes="(min-width: 1024px) 40vw, 100vw"><img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async"></picture></div>
    </div>
  </div>
</section>
