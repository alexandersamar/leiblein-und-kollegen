---
// Vertrauensleiste (DATEV + Mitgliedschaften); band = false → ohne Laufband „Weitsicht + Klartext“ (Unterseiten)
const { band = true } = Astro.props;
---
<!-- ====================== 2 · Vertrauen ====================== -->
<section class="seals-d" aria-label="Auszeichnungen und Mitgliedschaften">
  <div class="container seals-d__inner">
    <div class="seals-d__datev">
      <img src="/assets/img/real/datev-digitale-kanzlei-2026-168.png" alt="DATEV-Label Digitale Kanzlei 2026" width="56" height="53">
      <span><b>DATEV Digitale Kanzlei 2026</b>Ausgezeichnet für digitale Zusammenarbeit</span>
    </div>
    <div class="seals-d__marquee">
      <ul class="sr-only"><li>StBK Nürnberg – Steuerberaterkammer</li><li>DStV – Fachberatung Gesundheitswesen</li><li>KfW – Gründungscoach</li><li>DHBW – Partnerunternehmen</li><li>LSWB · StBV Hessen · StBV Berlin-Brandenburg – Steuerberaterverbände</li></ul>
      <div class="seals-d__track" aria-hidden="true"><span class="seals-d__half"><span class="seals-d__item"><b>StBK Nürnberg</b><span>Steuerberaterkammer</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>DStV</b><span>Fachberatung Gesundheitswesen</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>KfW</b><span>Gründungscoach</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>DHBW</b><span>Partnerunternehmen</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>LSWB · StBV Hessen · StBV Berlin-Brandenburg</b><span>Steuerberaterverbände</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>StBK Nürnberg</b><span>Steuerberaterkammer</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>DStV</b><span>Fachberatung Gesundheitswesen</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>KfW</b><span>Gründungscoach</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>DHBW</b><span>Partnerunternehmen</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>LSWB · StBV Hessen · StBV Berlin-Brandenburg</b><span>Steuerberaterverbände</span></span><i aria-hidden="true">+</i></span><span class="seals-d__half"><span class="seals-d__item"><b>StBK Nürnberg</b><span>Steuerberaterkammer</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>DStV</b><span>Fachberatung Gesundheitswesen</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>KfW</b><span>Gründungscoach</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>DHBW</b><span>Partnerunternehmen</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>LSWB · StBV Hessen · StBV Berlin-Brandenburg</b><span>Steuerberaterverbände</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>StBK Nürnberg</b><span>Steuerberaterkammer</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>DStV</b><span>Fachberatung Gesundheitswesen</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>KfW</b><span>Gründungscoach</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>DHBW</b><span>Partnerunternehmen</span></span><i aria-hidden="true">+</i><span class="seals-d__item"><b>LSWB · StBV Hessen · StBV Berlin-Brandenburg</b><span>Steuerberaterverbände</span></span><i aria-hidden="true">+</i></span></div>
    </div>
  </div>
</section>

{band && (<div class="e-band" aria-hidden="true"><div class="e-band__track e-band__track--loop"><span class="e-band__half"><span>Weitsicht</span><i>+</i><span>Klartext</span><i>+</i><span>Eine Hand</span><i>+</i><span>Weitsicht</span><i>+</i><span>Klartext</span><i>+</i><span>Eine Hand</span><i>+</i><span>Weitsicht</span><i>+</i><span>Klartext</span><i>+</i><span>Eine Hand</span><i>+</i></span><span class="e-band__half"><span>Weitsicht</span><i>+</i><span>Klartext</span><i>+</i><span>Eine Hand</span><i>+</i><span>Weitsicht</span><i>+</i><span>Klartext</span><i>+</i><span>Eine Hand</span><i>+</i><span>Weitsicht</span><i>+</i><span>Klartext</span><i>+</i><span>Eine Hand</span><i>+</i></span></div></div>)}
