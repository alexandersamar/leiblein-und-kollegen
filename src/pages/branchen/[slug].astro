---
// Vorlage der Branchenseiten (Handwerk, E-Commerce, Immobilien, GmbH & Personengesellschaften) – Aufbau wie Gesundheitswesen
// Kopf → Vertrauen → Zielgruppen → Leistungsumfang → Situationen → Warum wir → Stimmen → Ablauf → FAQ → Abschluss
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/page/PageHero.astro';
import FaqBlock from '../../components/page/FaqBlock.astro';
import WarumWir from '../../components/page/WarumWir.astro';
import Vertrauen from '../../components/home/Vertrauen.astro';
import Ablauf from '../../components/home/Ablauf.astro';
import Stimmen from '../../components/home/Stimmen.astro';
import Abschluss from '../../components/home/Abschluss.astro';
import { url, services } from '../../data/site';
import { branchen, type Branche } from '../../data/branchen';
import { faqJsonLd } from '../../data/faqJsonLd';

export function getStaticPaths() {
  return branchen.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props as { b: Branche };
---
<Base title={b.seo.title} description={b.seo.description} jsonLd={[faqJsonLd(b.faq)]}>

<PageHero
  crumbs={[{ label: 'Branchen', href: url.branchen }, { label: b.label }]}
  eyebrow={b.eyebrow}
  title={b.title}
  lead={b.lead}
  note={b.note}
  team
  frame
  img={b.img}
/>

<Vertrauen band={false} />

<!-- Für wen: Kopf links, Zielgruppen rechts auf Linien -->
<section class="section section--paper">
  <div class="container aud-wrap">
    <div class="col-head reveal">
      <div class="d-head__top"><span class="d-eyebrow">Für wen wir arbeiten</span>
      <h2 class="d-title" set:html={b.groupsHead.title} /></div>
      <p class="lead">{b.groupsHead.lead}</p>
    </div>
    <ol class="aud reveal">
      {b.groups.map((g, i) => <li class="aud__item"><span class="aud__num">{String(i + 1).padStart(2, '0')}</span><h3>{g.title}</h3><p>{g.text}</p></li>)}
    </ol>
  </div>
</section>

<!-- Leistungsumfang: dunkle Sektion wie auf den Leistungsseiten -->
<section class="section section--solid">
  <div class="container split">
    <div class="split__head reveal"><div class="d-head__top"><span class="d-eyebrow">Leistungsumfang</span><h2 class="d-title">Was wir <em>für Sie übernehmen.</em></h2></div><a class="btn btn--primary" href={url.anfrage}>Erstgespräch anfragen <svg class="icon icon--arrow"><use href="#i-arrow"/></svg></a></div>
    <ul class="scope reveal">{b.scope.map((x) => <li>{x}</li>)}</ul>
  </div>
</section>

<!-- Situationen (Bildsprache wie Startseite) -->
<section class="section">
  <div class="container">
    <div class="d-head reveal">
      <div class="d-head__top"><span class="d-eyebrow">Aus dem Alltag</span>
      <h2 class="d-title d-title--line">Vier Momente, <em>in denen wir an Ihrer Seite sind.</em></h2></div>
      <p>Vom Start bis zur Übergabe – mit festen Ansprechpartnern, die Ihre Branche kennen.</p>
    </div>
    <div class="sit reveal">
      {b.situations.map((s, i) => (
        <article class="sit-step">
          <div class="sit-step__mark"><span class="sit-step__dot" aria-hidden="true"></span><b>{String(i + 1).padStart(2, '0')} · {s.tag}</b></div>
          <div class="sit-step__qa"><div class="sit-step__q"><h3>„{s.q}“</h3></div>
          <div class="sit-step__a"><ul>{s.a.map((x) => <li>{x}</li>)}</ul><a class="link-arrow sit-step__link" href={services[s.link].href}><span>{services[s.link].label}</span> <svg class="icon"><use href="#i-arrow"/></svg></a></div></div>
        </article>
      ))}
    </div>
  </div>
</section>

<WarumWir person={b.person} paper />

<Stimmen />

<Ablauf />

<FaqBlock items={b.faq} />

<Abschluss />

</Base>
