---
// Wissen: Seite 2, 3 … eines Themas
import WissenList from '../../../../../components/page/WissenList.astro';
import { allPosts, categories, catSlug, pages } from '../../../../../data/postsUtil';
export function getStaticPaths() {
  return categories.flatMap((c) => { const p = pages(allPosts.filter((x) => x.category === c)); return p.slice(1).map((items, i) => ({ params: { cat: catSlug(c), n: String(i + 2) }, props: { items, page: i + 2, total: p.length, cat: c } })); });
}
const { items, page, total, cat } = Astro.props;
---
<WissenList items={items} page={page} total={total} cat={cat} />
