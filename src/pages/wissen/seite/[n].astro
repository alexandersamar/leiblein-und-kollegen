---
// Wissen: Seite 2, 3 … aller Beiträge
import WissenList from '../../../components/page/WissenList.astro';
import { allPosts, pages } from '../../../data/postsUtil';
export function getStaticPaths() {
  const p = pages(allPosts);
  return p.slice(1).map((items, i) => ({ params: { n: String(i + 2) }, props: { items, page: i + 2, total: p.length } }));
}
const { items, page, total } = Astro.props;
---
<WissenList items={items} page={page} total={total} cat={null} />
